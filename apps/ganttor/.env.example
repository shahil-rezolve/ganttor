# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API  (URL) — the bare project URL only,
#     e.g. https://abcd1234.supabase.co (no /rest/v1 suffix; supabase-js appends its own)
#   Dashboard -> Project Settings -> API Keys  (anon / publishable key)
#
# The anon key is public by design — it ships in the browser bundle. Row Level Security
# in supabase/schema.sql is what actually protects the data, so run that SQL before
# trusting this. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Then create the single login user:
#   Dashboard -> Authentication -> Users -> Add user -> Create new user
#   (tick "Auto Confirm User", or the first sign-in will fail on an unconfirmed email)
