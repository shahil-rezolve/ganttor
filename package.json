{
  "name": "ganttor-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ganttor/app dev",
    "build": "pnpm --filter @ganttor/gantt build && pnpm --filter @ganttor/app build",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @ganttor/gantt test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@11.8.0"
}
